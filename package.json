{
  "name": "hotspot-messenger",
  "version": "1.0.0",
  "description": "Local Wi-Fi/hotspot group chat — message nearby devices without mobile data",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "vendor:copy": "node scripts/copy-vendor.js",
    "postinstall": "node scripts/copy-vendor.js",
    "cap:sync": "npx cap sync",
    "cap:open": "npx cap open android"
